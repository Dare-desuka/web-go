# HOW TO USE: copy this file to `.env`, then fill the empty values.
#   cp .env.example .env
# `.env` is gitignored and will NEVER be read by the coding agent.
# All sizes are in bytes (int64). See PRD.md section 28.

# --- Server ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Set to 1 in production so the admin session cookie gets the Secure flag.
COOKIE_SECURE=

# --- Database ---
DATABASE_PATH=data/app.db

# --- Upload limits (defaults already correct, usually leave as-is) ---
# 900 MiB (UI may display "900 MB")
MAX_PART_SIZE=943718400
# 20 GiB global per-movie upload limit
MAX_MOVIE_SIZE=21474836480

# --- Frontend (browser origin allowed by API CORS) ---
# Comma-separated; must match where you open the Next.js dev server.
FRONTEND_URL=http://127.0.0.1:3003

# --- Telegram (server-side only, never expose to frontend) ---
# From https://my.telegram.org (logged in as the dedicated project account).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Created by backend/cmd/tglogin: either a PATH to the session file
# (recommended, survives auth refreshes) or the base64 payload it prints.
TELEGRAM_SESSION=
# Numeric ID of the PRIVATE CHANNEL (tglogin helps resolve it).
TELEGRAM_CHANNEL_ID=
